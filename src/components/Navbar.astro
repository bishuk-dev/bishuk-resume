---
import { Mail } from '@lucide/astro';
import { profile } from '../data/resume';
---
<header class="sticky top-0 z-50 border-b border-white/6 bg-[#061018]/84 backdrop-blur-xl">
  <nav class="shell flex min-h-16 items-center justify-between gap-5" aria-label="Primary navigation">
    <a href="#top" class="mono text-sm font-semibold tracking-[.16em] text-white">BISHU<span class="text-cyan-300">.DEV</span></a>
    <div class="hidden items-center gap-6 text-sm text-slate-300 md:flex">
      <a class="hover:text-white" href="#about">About</a>
      <a class="hover:text-white" href="#skills">Skills</a>
      <a class="hover:text-white" href="#projects">Projects</a>
      <a class="hover:text-white" href="#education">Education</a>
    </div>
    <div class="flex items-center gap-2">
      <a class="mono flex h-[34px] min-w-[34px] items-center justify-center rounded-md border border-white/10 px-2 text-[10px] font-bold tracking-[.08em] text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" href={profile.links.github} target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a class="flex h-[34px] min-w-[34px] items-center justify-center rounded-md border border-white/10 px-2 text-[13px] font-bold text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <a class="rounded-md border border-white/10 p-2 text-slate-300 hover:border-cyan-300/40 hover:text-cyan-200" href={profile.links.email} aria-label="Email"><Mail size={17} /></a>
    </div>
  </nav>
</header>
