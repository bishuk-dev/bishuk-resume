---
interface Props { index: string; eyebrow: string; title: string; description?: string; }
const { index, eyebrow, title, description } = Astro.props;
---
<div data-reveal>
  <div class="section-kicker">{index} // {eyebrow}</div>
  <h2 class="section-title">{title}</h2>
  {description && <p class="section-copy">{description}</p>}
</div>
