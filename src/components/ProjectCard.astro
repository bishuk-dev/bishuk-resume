---
interface Project {
  index: string;
  title: string;
  eyebrow: string;
  description: string;
  highlights: string[];
  stack: string[];
  href: string;
  status: string;
}
const { project } = Astro.props as { project: Project };
---
<article class="project-cartridge">
  <div class="cartridge-label">
    <div class="project-index">QUEST_{project.index} // {project.status}</div>
    <h3>{project.title}</h3>
    <p class="project-eyebrow">{project.eyebrow}</p>
    <p class="project-description">{project.description}</p>
    <ul class="project-highlights">
      {project.highlights.map((item) => <li>{item}</li>)}
    </ul>
    <div class="project-stack">
      {project.stack.map((item) => <span>{item}</span>)}
    </div>
    <a class="project-link" href={project.href} target="_blank" rel="noreferrer">OPEN REPOSITORY ↗</a>
  </div>
</article>
