---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, skills, projects, now } from '../data/resume';
---
<BaseLayout>
  <Navbar />

  <main>
    <section id="top" class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="pixel-orb" aria-hidden="true"></div>

      <div class="shell hero-layout">
        <div>
          <div class="boot-stack" aria-label="System status">
            <span class="boot-line ok">[OK] PROFILE_LOADED</span>
            <span class="boot-line">CLASS: CSE_AI_ML</span>
            <span class="boot-line">MODE: BUILDING</span>
          </div>

          <h1 class="hero-title" aria-label="Bishu Kumar">
            <span class="mask"><span class="word">Bishu</span></span>
            <span class="mask"><span class="word alt">Kumar</span></span>
          </h1>

          <p class="hero-copy">
            <strong>Backend systems, applied AI, data engineering.</strong><br />
            I build projects where architecture, algorithms, and correctness are part of the product—not hidden behind a shiny landing page.
          </p>

          <div class="hero-actions">
            <a class="pixel-button" href="#journey">START QUEST ↓</a>
            <a class="pixel-button secondary" href={profile.links.github} target="_blank" rel="noreferrer">OPEN GITHUB ↗</a>
          </div>
        </div>

        <aside class="player-card pixel-box" aria-label="Player profile">
          <div class="card-top">
            <span>PLAYER_01</span>
            <span>LV. 02</span>
          </div>

          <div class="avatar-screen">
            <svg viewBox="0 0 160 160" role="img" aria-label="Original pixel-style developer avatar" shape-rendering="crispEdges">
              <rect width="160" height="160" fill="#10152d"/>
              <rect x="32" y="20" width="96" height="18" fill="#18111f"/>
              <rect x="22" y="38" width="116" height="18" fill="#2d2438"/>
              <rect x="32" y="56" width="96" height="48" fill="#f0c7a7"/>
              <rect x="22" y="65" width="18" height="30" fill="#f0c7a7"/>
              <rect x="120" y="65" width="18" height="30" fill="#f0c7a7"/>
              <rect x="46" y="68" width="22" height="12" fill="#111525"/>
              <rect x="92" y="68" width="22" height="12" fill="#111525"/>
              <rect x="68" y="72" width="24" height="6" fill="#61e8ff"/>
              <rect x="60" y="90" width="40" height="8" fill="#9d5c63"/>
              <rect x="48" y="104" width="64" height="18" fill="#f0c7a7"/>
              <rect x="34" y="120" width="92" height="32" fill="#8d6cff"/>
              <rect x="18" y="132" width="24" height="20" fill="#8d6cff"/>
              <rect x="118" y="132" width="24" height="20" fill="#8d6cff"/>
              <rect x="66" y="120" width="28" height="32" fill="#16182d"/>
              <rect x="72" y="128" width="16" height="8" fill="#b8f35f"/>
            </svg>
          </div>

          <ul class="stat-list">
            <li><b>Class</b><span>{profile.role}</span></li>
            <li><b>Focus</b><span>{profile.focus}</span></li>
            <li><b>Base</b><span>{profile.location}</span></li>
          </ul>
        </aside>
      </div>

      <div class="scroll-prompt">SCROLL TO EXPLORE ↓</div>
    </section>

    <section id="journey" class="journey">
      <div class="journey-stage">
        <div class="journey-overlay-copy">
          <SectionHeading
            index="01"
            eyebrow="World Map"
            title="My current dev journey, rendered like a quest line."
            description="The map zooms as you scroll. Each checkpoint is a real stage in what I am learning or building—not a fake career timeline."
          />
        </div>

        <div class="world-frame" aria-hidden="true">
          <div class="world-map">
            <div class="map-land land-a"></div>
            <div class="map-land land-b"></div>
            <svg class="map-path" viewBox="0 0 1200 780" preserveAspectRatio="none">
              <polyline class="map-path-base" points="185,220 420,390 650,255 860,465 1085,625" />
              <polyline class="map-path-progress" points="185,220 420,390 650,255 860,465 1085,625" />
            </svg>

            <div class="map-node node-1" data-map-node>
              <b>SPAWN POINT</b>
              <span>B.Tech CSE — AI & ML</span>
            </div>
            <div class="map-node node-2" data-map-node>
              <b>TRAINING GROUNDS</b>
              <span>DSA, backend fundamentals, systems thinking</span>
            </div>
            <div class="map-node node-3" data-map-node>
              <b>MOCKMATE LAB</b>
              <span>AST parsing, DAGs, AI-assisted data generation</span>
            </div>
            <div class="map-node node-4" data-map-node>
              <b>BITCOIN INTEL ZONE</b>
              <span>Parquet, DuckDB, Neo4j, deterministic feature pipelines</span>
            </div>
            <div class="map-node node-5" data-map-node>
              <b>CURRENT QUEST</b>
              <span>Deeper backend + practical AI engineering</span>
            </div>
          </div>
          <div class="map-camera-label">CAMERA_LOCK // QUEST_PATH</div>
        </div>
      </div>
    </section>

    <section id="skills" class="inventory">
      <div class="shell">
        <SectionHeading
          index="02"
          eyebrow="Inventory"
          title="Skills as equipment, not decorative badges."
          description="No fake percentage bars. These are technologies and concepts I can actually place inside projects and explain."
        />

        <div class="inventory-grid">
          {skills.map((skill, index) => (
            <article class="inventory-card">
              <div class="slot-number">SLOT_{String(index + 1).padStart(2, '0')}</div>
              <h3>{skill.group}</h3>
              <div class="inventory-items">
                {skill.items.map((item) => <span>{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="projects-section">
      <div class="projects-stage">
        <div class="projects-heading">
          <SectionHeading
            index="03"
            eyebrow="Main Quests"
            title="Project cartridges. Scroll sideways through the hard stuff."
            description="Desktop turns this section into a pinned horizontal journey. Mobile keeps it stacked and readable."
          />
        </div>

        <div class="project-track">
          {projects.map((project) => <ProjectCard project={project} />)}

          <article class="project-cartridge">
            <div class="cartridge-label sidequest-label">
              <div>
                <div class="project-index">SIDE_QUESTS // OPEN WORLD</div>
                <h3>More builds live on GitHub.</h3>
                <p class="project-description">
                  Smaller experiments, frontend builds, DSA work, and projects that are useful as learning checkpoints even when they are not portfolio headliners.
                </p>
                <a class="project-link" href={profile.links.github} target="_blank" rel="noreferrer">EXPLORE ALL REPOS ↗</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="status" class="status-zone">
      <div class="shell">
        <SectionHeading
          index="04"
          eyebrow="Status Screen"
          title="Still leveling up. That is the point."
          description="The site should show ambition without pretending I already have ten years of industry experience."
        />

        <div class="status-layout">
          <div class="dialogue-box pixel-box" data-reveal>
            <div class="speaker">BISHU // DIALOGUE</div>
            <p>
              I’m a computer science student using bigger projects to force myself to learn architecture, data modeling, algorithms, debugging, and AI engineering beyond tutorial-level demos.
            </p>
            <div class="education-card">
              <b>{profile.education.degree}</b>
              <span>{profile.education.school} · {profile.education.period}</span>
            </div>
          </div>

          <div class="quest-list" data-reveal>
            {now.map((item) => <div class="quest-item">{item}</div>)}
          </div>
        </div>
      </div>
    </section>

    <section class="contact-zone">
      <div class="continue-box pixel-box" data-reveal>
        <div class="section-kicker">05 // Continue?</div>
        <h2>New quest?</h2>
        <p>
          If the work involves backend engineering, data-heavy systems, practical AI, or something technically weird enough to be interesting, I want to hear about it.
        </p>
        <div class="continue-actions">
          <a class="pixel-button" href={profile.links.email}>SEND MESSAGE</a>
          <a class="pixel-button secondary" href={profile.links.linkedin} target="_blank" rel="noreferrer">LINKEDIN ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer-inner">
      <span>© 2026 BISHU KUMAR // SAVE FILE ACTIVE</span>
      <span>ASTRO + GSAP + LENIS // ORIGINAL PIXEL UI</span>
    </div>
  </footer>
</BaseLayout>
